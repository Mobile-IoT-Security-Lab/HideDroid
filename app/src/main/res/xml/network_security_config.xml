<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Only permit cleartext traffic to the local netbare proxy / loopback.
         Global usesCleartextTraffic="true" is removed to avoid weakening
         TLS for arbitrary remote endpoints. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
