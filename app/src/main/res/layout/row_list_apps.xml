<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:padding="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <ImageView
            android:id="@+id/iconAppRepacking"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.208"
            app:srcCompat="@android:drawable/sym_def_app_icon" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/idPackageName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="64dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/roboto"
            android:text="package_name"
            android:textColor="@android:color/black"
            android:textSize="14sp"
            app:layout_constraintStart_toEndOf="@+id/iconAppRepacking"
            app:layout_constraintTop_toTopOf="@+id/iconAppRepacking" />

        <TextView
            android:id="@+id/isInstalled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Installed"
            android:textColor="@color/icon_background"
            android:textStyle="italic"
            app:layout_constraintStart_toStartOf="@+id/idPackageName"
            app:layout_constraintTop_toBottomOf="@+id/idPackageName" />

        <LinearLayout
            android:id="@+id/trackingModeButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/idPackageName"
            app:layout_constraintTop_toBottomOf="@+id/isInstalled">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonTrackNoRepack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="4dp"
                android:fontFamily="@font/roboto"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/action_track_no_repack_short"
                android:textColor="@android:color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@color/repack_mode_button_background"
                android:checkable="true"
                app:cornerRadius="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonTrackRepack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:elevation="4dp"
                android:fontFamily="@font/roboto"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/action_track_repack_short"
                android:textColor="@android:color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                app:backgroundTint="@color/repack_mode_button_background"
                android:checkable="true"
                app:cornerRadius="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonInstallRepacked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="4dp"
                android:fontFamily="@font/roboto"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/action_install_repacked_short"
                android:textColor="@android:color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                app:cornerRadius="20sp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
